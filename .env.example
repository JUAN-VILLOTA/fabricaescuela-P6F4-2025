
# ============================================
# VARIABLES DE ENTORNO - EJEMPLO
# ============================================
# Copia este archivo como .env y ajusta los valores según tu entorno
# NUNCA subas el archivo .env a Git (ya está en .gitignore)

# -------------------------------
# 🔧 CONFIGURACIÓN GENERAL
# -------------------------------
SERVER_PORT=8080

# -------------------------------
# 🔐 CONFIGURACIÓN JWT
# -------------------------------
# Secret para firmar tokens (cambiar en producción)
JWT_SECRET=mySecretKeyForJWTTokenGenerationThatIsLongEnough123456789
# Tiempo de expiración en milisegundos (86400000 = 24 horas)
JWT_EXPIRATION=86400000

# -------------------------------
# 🌐 CONFIGURACIÓN CORS
# -------------------------------
# Orígenes permitidos separados por comas
# Desarrollo: usar *
# Producción: usar dominios específicos
CORS_ALLOWED_ORIGINS=*

# -------------------------------
# 💾 CONEXIÓN A BASE DE DATOS POSTGRESQL
# -------------------------------
# URL completa de conexión
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/inventario_db
# Usuario de PostgreSQL
SPRING_DATASOURCE_USERNAME=postgres
# Contraseña de PostgreSQL
SPRING_DATASOURCE_PASSWORD=postgres

# -------------------------------
# 🔗 CONFIGURACIÓN DE POOL DE CONEXIONES
# -------------------------------
# Tamaño máximo del pool
HIKARI_MAX_POOL_SIZE=10
# Tiempo de inactividad antes de cerrar (milisegundos)
HIKARI_IDLE_TIMEOUT=600000
# Tiempo máximo de vida de una conexión (milisegundos)
HIKARI_MAX_LIFETIME=1800000
# Timeout de conexión (milisegundos)
HIKARI_CONNECTION_TIMEOUT=30000

# -------------------------------
# 📊 CONFIGURACIÓN JPA / HIBERNATE
# -------------------------------
# Estrategia DDL: update, create, create-drop, validate, none
SPRING_JPA_HIBERNATE_DDL_AUTO=update
